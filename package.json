{
  "name": "power",
  "version": "0.4.0",
  "description": "Your agents, one room: Claude Code, Codex, Hermes, opencode and every agent CLI on your Mac in one desktop app, with group chat, persona packs and Obsidian memory.",
  "scripts": {
    "test": "node --test",
    "test:browser": "POWER_TEST_BROWSER=1 node --test browser.test.mjs",
    "browser:install": "playwright-core install chromium",
    "desktop:build": "node desktop/build.mjs",
    "desktop:start": "electron desktop/main.cjs",
    "test:desktop": "POWER_TEST_DESKTOP=1 node --test desktop-browser.test.mjs",
    "windows:build": "node desktop/build-windows.mjs",
    "start": "node desktop/launch.mjs"
  },
  "keywords": [
    "claude-code",
    "codex",
    "mcp",
    "ai-agents",
    "multi-agent",
    "group-chat",
    "obsidian",
    "macos"
  ],
  "author": "zhixuanlucasfeng-cmyk",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@playwright/mcp": "0.0.83",
    "cross-spawn": "^7.0.6",
    "fast-xml-parser": "^5.11.2",
    "jszip": "^3.10.2",
    "zod": "^4.6.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zhixuanlucasfeng-cmyk/power"
  },
  "devDependencies": {
    "electron": "44.7.0"
  }
}
